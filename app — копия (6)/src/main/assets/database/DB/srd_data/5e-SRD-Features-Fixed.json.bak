  },
  {
    "index_name": "druid-land-natures-ward",
    "name": "Природная защита",
    "description": "По достижении 10-го уровня вы не можете быть очарованы или испуганы элементалями или феями, и вы получаете иммунитет к болезням и ядам.",
    "level": 10,
    "class_index": "druid",
