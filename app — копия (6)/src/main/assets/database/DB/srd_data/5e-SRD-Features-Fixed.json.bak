    "ui_group": "GENERAL"
  },
  {
    "index_name": "paladin-ancients-oath-spells",
    "name": "Заклинания клятвы древних",
    "description": "Вы получаете заклинания клятвы на определенных уровнях паладина. На 3-м уровне: Удерживание личности, Громовая волна. На 5-м: Туманный шаг, Лунный свет. На 9-м: Защита от энергии, Разговор с растениями. На 13-м: Ледяная буря, Каменная кожа. На 17-м: Общение с природой, Древесный шаг.",
    "level": 3,
    "class_index": "paladin",
    "subclass_index": "ancients",
