  },
  {
    "index_name": "paladin-oathbreaker-aura-of-hate",
    "name": "Аура ненависти",
    "description": "Начиная с 7-го уровня, вы и любая нежить или исчадия в пределах 10 футов от вас получаете бонус к броскам урона оружием ближнего боя, равный вашему модификатору Харизмы (минимум +1). Существо может получать преимущество только от одной такой ауры одновременно.\nНа 18-м уровне радиус этой ауры увеличивается до 30 футов.",
    "level": 7,
    "class_index": "paladin",
    "subclass_index": "oathbreaker",
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
