    "prerequisites_json": null,
    "reference_json": null,
    "ui_group": "GENERAL"
  },
  {
    "index_name": "druid-asi-1",
    "name": "Увеличение характеристик (4 уровень)",
    "description": "При достижении 4-го уровня вы можете повысить значение характеристики на ваш выбор на 2 или двух на 1. Вы не можете поднять значение выше 20 с помощью этого умения.",
    "level": 4,
    "class_index": "druid",
    "subclass_index": null,
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
