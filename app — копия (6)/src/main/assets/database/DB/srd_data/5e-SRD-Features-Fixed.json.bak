    "prerequisites_json": [],
    "reference_json": {},
    "ui_group": "GENERAL"
  },
  {
    "index_name": "paladin-ancients-channel-divinity-turn-the-faithless",
    "name": "Божественный канал: Изгнать неверных",
    "description": "Вы можете использовать свой Божественный канал, чтобы произносить древние слова, которые ужасают фей и исчадий. Действием вы предъявляете свой святой символ, и каждое фея или исчадие в пределах 30 футов от вас, которое может слышать вас, должно совершить спасбросок Мудрости. При провале существо изгоняется на 1 минуту или пока не получит урон. Если истинный облик существа скрыт иллюзией или превращением, его истинный облик раскрывается, пока оно изгнано.",
    "level": 3,
    "class_index": "paladin",
    "subclass_index": "ancients",
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
    "choices_json": null,
