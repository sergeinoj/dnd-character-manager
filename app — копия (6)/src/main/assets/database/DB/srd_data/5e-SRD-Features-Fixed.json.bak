    "ui_group": "GENERAL"
  },
  {
    "index_name": "maneuver-disarming-attack",
    "name": "Обезоруживающая атака",
    "description": "Когда вы попадаете по существу атакой оружием, вы можете потратить одну кость превосходства, чтобы попытаться обезоружить цель, заставив её уронить один предмет по вашему выбору, который она держит. Вы добавляете кость превосходства к броску урона атаки, и цель должна совершить спасбросок Силы. При провале она роняет выбранный предмет. Предмет падает у её ног.",
    "level": 3,
    "class_index": "fighter",
    "subclass_index": "battle-master",
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
