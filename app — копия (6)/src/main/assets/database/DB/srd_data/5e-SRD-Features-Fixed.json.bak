    "prerequisites_json": [],
    "reference_json": {},
    "ui_group": "GENERAL"
  },
  {
    "index_name": "warlock-misty-escape",
    "name": "Туманный побег",
    "description": "Начиная с 6-го уровня вы можете исчезать в облаке тумана, когда получаете урон. Если вы получаете урон, вы можете реакцией стать невидимым и телепортироваться на расстояние до 60 футов в свободное пространство, которое видите. Вы остаётесь невидимым до начала своего следующего хода, или пока не атакуете или не наложите заклинание.\nИспользовав это умение, вы не можете использовать его снова, пока не завершите короткий или продолжительный отдых.",
    "level": 6,
    "class_index": "warlock",
    "subclass_index": "archfey",
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
