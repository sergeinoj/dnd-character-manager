[
  {
    "index_name": "ability-score-improvement",
    "name": "Увеличение характеристик / Черта",
    "description": "При достижении определённых уровней вашего класса, вы можете повысить значение одной из ваших характеристик на 2, либо повысить две характеристики на 1. По согласованию с Мастером, вы можете вместо этого улучшения выбрать одну Черту (Feat), если ваш персонаж соответствует её требованиям.",
    "level": 4,
    "class_index": null,
    "ui_group": "GENERAL",
    "choices_json": {
      "choose": 1,
      "type": "asi_or_feat",
      "from": {
        "option_set_type": "options_array",
        "options": [
          {
            "option_type": "ability_score_increase",
            "points": 2
          },
          {
            "option_type": "feat_choice",
            "from": {
              "resource": "general_feats"
            }
          }
        ]
      }
    },
    "subclass_index": null
  },
  {
    "index_name": "action-surge-1-use",
    "name": "Всплеск Действий (1 использование)",
    "description": "Начиная со 2-го уровня, вы можете на мгновение превзойти свои обычные пределы. В свой ход вы можете совершить одно дополнительное действие поверх своего обычного действия и возможного бонусного действия.\nИспользовав эту особенность, вы должны завершить короткий или продолжительный отдых, прежде чем сможете использовать её снова. Начиная с 17-го уровня, вы можете использовать её дважды до отдыха, но только один раз за ход.",
    "level": 2,
    "class_index": "fighter",
    "subclass_index": null,
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
    "choices_json": null,
    "spell_show_json": null,
    "change_rule": 0,
    "prerequisites_json": null,
    "reference_json": null,
    "ui_group": "GENERAL"
  },
  {
    "index_name": "action-surge-2-uses",
    "name": "Всплеск Действий (2 использования)",
    "description": "Начиная со 2-го уровня, вы можете на мгновение превзойти свои обычные пределы. В свой ход вы можете совершить одно дополнительное действие в дополнение к вашему обычному действию и возможному дополнительному действию.\nПосле того как вы используете это умение, вы должны завершить Короткий или Длительный отдых, прежде чем сможете использовать его снова. Начиная с 17-го уровня, вы можете использовать его дважды между отдыхами, но только один раз в один и тот же ход.",
    "level": 17,
    "class_index": "fighter",
    "subclass_index": null,
    "race_index": null,
    "subrace_index": null,
