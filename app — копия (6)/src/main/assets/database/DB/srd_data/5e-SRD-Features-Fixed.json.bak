  {
    "index_name": "divine-strike",
    "name": "Божественный удар",
    "description": "На 8-м уровне вы получаете возможность наполнять удары оружием божественной энергией. Один раз за каждый свой ход, когда вы попадаете по существу атакой оружием, вы можете заставить атаку нанести цели дополнительный урон излучением 1к8. Когда вы достигаете 14-го уровня, дополнительный урон увеличивается до 2к8.",
    "level": 8,
    "class_index": "cleric",
    "subclass_index": "life",
    "race_index": null,
    "subrace_index": null,
    "background_index": null,
    "choices_json": null,
    "spell_show_json": null,
    "change_rule": 0,
    "prerequisites_json": null,
    "reference_json": null,
    "ui_group": "GENERAL"
  },
  {
    "index_name": "divine-strike-radiant",
    "name": "Божественный удар (Излучение)",
    "description": "На 8-м уровне вы получаете способность наполнять свои удары оружием божественной энергией. Один раз в каждом своем ходу, когда вы попадаете по существу атакой оружием, вы можете заставить атаку нанести цели дополнительные 1d8 урона излучением. На 14-м уровне этот урон увеличивается до 2d8.",
    "level": 8,
    "class_index": "cleric",
    "subclass_index": "life",
